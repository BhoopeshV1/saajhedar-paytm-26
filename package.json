{
  "name": "thunai",
  "private": true,
  "license": "MIT",
  "version": "0.1.0",
  "type": "module",
  "description": "Saajhedar - a voice-first business partner for the neighbourhood shop. Hackathon prototype.",
  "scripts": {
    "dev": "bun run --hot server/index.ts & vite --config web/vite.config.ts",
    "server": "bun run --hot server/index.ts",
    "web": "vite --config web/vite.config.ts",
    "build": "vite build --config web/vite.config.ts",
    "start": "bun run server/index.ts",
    "seed": "bun run server/seed.ts --reset",
    "prep:area": "bun run scripts/prep-area.ts",
    "typecheck": "tsc --noEmit -p web && tsc --noEmit -p server"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^1.8.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/noto-sans-devanagari": "^5.3.0",
    "@fontsource/noto-sans-tamil": "^5.3.0",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@duckdb/node-api": "^2.0.0-r.1",
    "@types/bun": "^1.4.4",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "typescript": "^7.0.2",
    "vite": "^8.3.8"
  }
}
