# Copy to .env and fill in. The server reads this file on start.
SARVAM_API_KEY=
ANTHROPIC_API_KEY=

# Optional
# CLAUDE_MODEL=claude-opus-5-5      # claude-haiku-5-5 answers faster
# CLAUDE_EFFORT=low
# SARVAM_STT_MODEL=saaras:v4
# SARVAM_TTS_MODEL=bulbul:v3
# SARVAM_TTS_SPEAKER=kavitha
# OWNER_PIN=1234
# PORT=8787

# Real supplier calls through Sarvam voice agents (optional). All are needed.
# SARVAM_AGENT_KEY=        # workspace API key from the voice agents dashboard, Settings > API Key
# SARVAM_ORG_ID=
# SARVAM_WORKSPACE_ID=
# SARVAM_AGENT_APP_ID=     # the agent to run
# SARVAM_AGENT_VERSION=1
# SARVAM_CONNECTION_ID=    # the telephony connection
# SARVAM_AGENT_NUMBER=     # the number the agent calls from
# CALL_TEST_NUMBER=        # the phone to ring in a test
# PUBLIC_URL=              # this app's public address, so call reports come back
